<UserControl x:Class="PrintPilotDesk.HoverCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="316" Cursor="Hand">
  <Border Background="#F21C2026" CornerRadius="14" Padding="14,12,14,12"
          BorderBrush="#3A414B" BorderThickness="1"
          TextElement.Foreground="#ECF0F4">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.4" Direction="270"/>
    </Border.Effect>
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="PrintPilot" FontWeight="SemiBold" FontSize="13"
                   Foreground="#2DD4BF" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Background="{Binding BadgeBrush}" CornerRadius="10" Padding="8,3">
          <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
        </Border>
      </Grid>

      <TextBlock Text="{Binding JobLine}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                 TextWrapping="Wrap" Foreground="#ECF0F4"/>
      <TextBlock Text="{Binding EtaLine}" FontSize="12" Foreground="#9AA3AD" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding Boost}" FontSize="12" Foreground="#F59E0B" Margin="0,2,0,0"
                 Visibility="{Binding BoostVisible}"/>

      <ProgressBar Height="6" Margin="0,10,0,2" Minimum="0" Maximum="100"
                   Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ProgressVisible}"
                   Foreground="#2DD4BF" Background="#333A44" BorderThickness="0"/>

      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="喷嘴 ℃" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Nozzle}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="热床 ℃" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Bed}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <TextBlock Text="层数" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Layer}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
          <TextBlock Text="剩余" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Remain}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>

      <Border Height="1" Background="#3A414B" Margin="0,10,0,8"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="PM2.5" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Pm25}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="室温 / 湿度" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Climate}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="有人" FontSize="10" Foreground="#9AA3AD"/>
          <TextBlock Text="{Binding Presence}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding AirNote}" FontSize="11" Foreground="#F59E0B" Margin="0,8,0,0"
                 Visibility="{Binding AirNoteVisible}"/>
      <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#9AA3AD" Margin="0,10,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
